# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (default when not set):
# DATABASE_URL=sqlite:///./glpack.db
#
# PostgreSQL (production):
DATABASE_URL=postgresql://glpack:password@localhost:5432/glpack

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# ── Token expiry ──────────────────────────────────────────────────────────────
TOKEN_EXPIRE_HOURS=8

# ── Legacy: DBF import path (only needed for seed scripts) ───────────────────
# GLPACK_DATA_DIR=C:\path\to\your\GLPACK\folder
